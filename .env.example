# Copy this file to .env and fill in your own EmailJS values (see README for
# the account setup steps). Also set these same 3 values in Cloudflare Pages →
# Settings → Environment variables so the deployed site can send backup emails.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# OAuth Client ID from Google Cloud Console (APIs & Services → Credentials →
# Create Credentials → OAuth client ID → Web application), with the Drive API
# enabled and this site's URL under "Authorized JavaScript origins". Also set
# in Cloudflare Pages → Settings → Environment variables for the deployed site.
VITE_GOOGLE_CLIENT_ID=
